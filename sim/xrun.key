database -open waves -into waves.shm -default
probe -create -shm bmu_tb_top.vif.a_in bmu_tb_top.vif.ap bmu_tb_top.vif.b_in bmu_tb_top.vif.clk bmu_tb_top.vif.csr_rddata_in bmu_tb_top.vif.csr_ren_in bmu_tb_top.vif.error bmu_tb_top.vif.result_ff bmu_tb_top.vif.rst_l bmu_tb_top.vif.scan_mode bmu_tb_top.vif.valid_in
run
run
reset
run
stop -create -object bmu_tb_top.vif.a_in -name bmu_tb_top.vif.a_in
stop -create -object bmu_tb_top.vif.ap -name bmu_tb_top.vif.ap
stop -create -object bmu_tb_top.vif.b_in -name bmu_tb_top.vif.b_in
stop -create -object bmu_tb_top.vif.clk -name bmu_tb_top.vif.clk
stop -create -object bmu_tb_top.vif.csr_rddata_in -name bmu_tb_top.vif.csr_rddata_in
stop -create -object bmu_tb_top.vif.csr_ren_in -name bmu_tb_top.vif.csr_ren_in
stop -create -object bmu_tb_top.vif.error -name bmu_tb_top.vif.error
stop -create -object bmu_tb_top.vif.result_ff -name bmu_tb_top.vif.result_ff
stop -create -object bmu_tb_top.vif.rst_l -name bmu_tb_top.vif.rst_l
stop -create -object bmu_tb_top.vif.scan_mode -name bmu_tb_top.vif.scan_mode
stop -create -object bmu_tb_top.vif.valid_in -name bmu_tb_top.vif.valid_in
exit
